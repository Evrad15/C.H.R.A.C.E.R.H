:root {
    --text: rgba(3, 2, 41, 1);
    --14-regular-font-family: "Inter", Helvetica;
    --14-regular-font-weight: 400;
    --14-regular-font-size: 14px;
    --14-regular-letter-spacing: 0px;
    --14-regular-line-height: 20px;
    --14-regular-font-style: normal;
    --single-line-body-base-font-family: "Inter", Helvetica;
    --single-line-body-base-font-weight: 400;
    --single-line-body-base-font-size: 16px;
    --single-line-body-base-letter-spacing: 0px;
    --single-line-body-base-line-height: 100%;
    --single-line-body-base-font-style: normal;
    --spacing-4: 4px;
    --spacing-20: 20px;
    --spacing-28: 28px;
    --spacing-size-20: 20px;
    --spacing-radius-8: 8px;
    --spacing-8-duplicate: 8px;
    --corner-radius-8: 8px;
    --icon-size-16: 16px;
    --collection-bool-en: none;
    --themes-black-40: rgba(28, 28, 28, 0.4);
    --themes-black-20: rgba(28, 28, 28, 0.2);
    --themes-black-5: rgba(28, 28, 28, 0.05);
    --color-text-default-default: var(--color-primitives-gray-900);
    --color-background-default-default: var(--color-primitives-white-1000);
    --color-border-default-default: var(--color-primitives-gray-300);
    --show-text-show-text: initial;
    --size-space-200: 8px;
    --size-space-150: 6px;
    --size-radius-200: 8px;
    --show-icon-show-icon: initial;
    --color-primitives-gray-900: rgba(30, 30, 30, 1);
    --color-primitives-white-1000: rgba(255, 255, 255, 1);
    --color-primitives-gray-300: rgba(217, 217, 217, 1);
    --color-primitives-gray-600: rgba(68, 68, 68, 1);
  }
  
  /*
  
  To enable a theme in your HTML, simply add one of the following data attributes to an HTML element, like so:
  
  <body data-spacing-mode="standard">
      <!-- the rest of your content -->
  </body>
  
  You can apply the theme on any DOM node, not just the `body`
  
  */
  
  [data-spacing-mode="standard"] {
    --spacing-4: 4px;
    --spacing-20: 20px;
    --spacing-28: 28px;
    --spacing-size-20: 20px;
    --spacing-8-duplicate: 8px;
  }
  
  [data-spacing-mode="expanded-4"] {
    --spacing-4: 8px;
    --spacing-20: 24px;
    --spacing-28: 32px;
    --spacing-size-20: 24px;
    --spacing-8-duplicate: 12px;
  }
  
  [data-spacing-mode="expanded-8"] {
    --spacing-4: 12px;
    --spacing-20: 28px;
    --spacing-28: 36px;
    --spacing-size-20: 16px;
    --spacing-8-duplicate: 16px;
  }
  
  [data-spacing-mode="condensed-4"] {
    --spacing-4: 0px;
    --spacing-20: 16px;
    --spacing-28: 24px;
    --spacing-size-20: 20px;
    --spacing-8-duplicate: 4px;
  }
  
  [data-corner-radius-mode="standard"] {
    --corner-radius-8: 8px;
  }
  
  [data-corner-radius-mode="expanded-4"] {
    --corner-radius-8: 12px;
  }
  
  [data-corner-radius-mode="expanded-8"] {
    --corner-radius-8: 16px;
  }
  
  [data-corner-radius-mode="condensed-4"] {
    --corner-radius-8: 4px;
  }
  
  [data-icon-size-mode="standard"] {
    --icon-size-16: 16px;
  }
  
  [data-icon-size-mode="expanded-4"] {
    --icon-size-16: 20px;
  }
  
  [data-icon-size-mode="expanded-8"] {
    --icon-size-16: 24px;
  }
  
  [data-icon-size-mode="condensed-4"] {
    --icon-size-16: 12px;
  }
  
  [data-themes-mode="pastel-light"] {
    --themes-black-40: rgba(28, 28, 28, 0.4);
    --themes-black-20: rgba(28, 28, 28, 0.2);
    --themes-black-5: rgba(28, 28, 28, 0.05);
  }
  
  [data-themes-mode="pastel-dark"] {
    --themes-black-40: rgba(255, 255, 255, 0.4);
    --themes-black-20: rgba(255, 255, 255, 0.2);
    --themes-black-5: rgba(255, 255, 255, 0.1);
  }
  
  [data-themes-mode="bright-light"] {
    --themes-black-40: rgba(46, 52, 62, 0.4);
    --themes-black-20: rgba(46, 52, 62, 0.2);
    --themes-black-5: rgba(46, 52, 62, 0.05);
  }
  
  [data-themes-mode="bright-dark"] {
    --themes-black-40: rgba(255, 255, 255, 0.4);
    --themes-black-20: rgba(255, 255, 255, 0.2);
    --themes-black-5: rgba(255, 255, 255, 0.1);
  }
  
  [data-color-mode="SDS-light"] {
    --color-text-default-default: var(--color-primitives-gray-900);
    --color-background-default-default: var(--color-primitives-white-1000);
    --color-border-default-default: var(--color-primitives-gray-300);
  }
  
  [data-color-mode="SDS-dark"] {
    --color-text-default-default: var(--color-primitives-white-1000);
    --color-background-default-default: var(--color-primitives-gray-900);
    --color-border-default-default: var(--color-primitives-gray-600);
  }
  
  [data-show-text-mode="true"] {
    --show-text-show-text: initial;
  }
  
  [data-show-text-mode="false"] {
    --show-text-show-text: none;
  }
  
  [data-show-icon-mode="true"] {
    --show-icon-show-icon: initial;
  }
  
  [data-show-icon-mode="false"] {
    --show-icon-show-icon: none;
  }
  